# 复制成 .env 后填真实值。.env 不要提交到版本库。

# ---- 服务 ----
APP_PORT=8080
# 用于派生加密用户 API Key 的 AES 密钥，随便一串足够长的随机字符即可。
# 一旦改动，已存的用户 key 将无法解密。
APP_SECRET=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_my

# ---- 各厂商的服务端默认 Key（留空则前台必须让用户自己填）----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 文心是两段式凭证，格式为 API_KEY:SECRET_KEY
ERNIE_API_KEY=

# ---- 本地 RAG 知识库（Ollama）----
# 嵌入模型 bge-m3（中英文都行，1024 维）；视觉模型用于把图片转成可检索的文字。
# 拉取：ollama pull bge-m3 && ollama pull qwen2.5vl:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
KB_EMBED_MODEL=bge-m3:latest
KB_VISION_MODEL=qwen2.5vl:7b

# ---- AI 自主工具调用（agent）----
# Agent 执行核心。服务启动时默认 eino；需要回退旧循环时设为 legacy。
AGENT_ENGINE=eino
# 总开关：1/true/on/yes 视为开启；不配时 /api/chat 行为与改造前完全一致。
AGENT_TOOLS=1
# 文件工具可操作的根目录（绝对路径）。为空则 read/write/edit/read_image 全部不注册。
# 注意：模型可在该目录内自由写入，不要指向家目录或代码仓库根。
AGENT_FS_ROOT=E:\blog-my\workspace
# 每阶段执行预算；0 或缺省时用内置默认值（模型 32 轮 / 工具 96 次）。
AGENT_MAX_ITERATIONS=32
AGENT_MAX_TOOL_CALLS=96
# 自主模式达到阶段预算后自动重新规划并续行的次数，0 关闭，最多 8（默认 2）。
# 默认总计最多 96 轮模型 / 288 次工具；达到总上限后保留现有结果，生成无工具的进度报告。
# 其它两种模式继续使用严格上限；用户取消、超时、权限限制仍立即生效。
AGENT_LIMIT_RECOVERY_ROUNDS=2
# 子 agent 默认至少有 24 轮模型调用预算；可单独覆盖。未设置时也尊重更高的 AGENT_MAX_ITERATIONS。
# AGENT_SUBAGENT_MAX_ITERATIONS=24
# 子 agent 默认最多 48 次工具调用；可单独覆盖。未设置时也尊重更高的 AGENT_MAX_TOOL_CALLS。
# AGENT_SUBAGENT_MAX_TOOL_CALLS=48
# Agent 自主档位（用户可在界面上改，这里是服务端默认）：
#   plan    = 只列计划，不执行任何工具
#   confirm = 风险操作（写/改/改名/删除）先问用户（缺省）
#   auto    = 自主执行，不再逐次确认
AGENT_MODE=confirm
# 自动记忆：把每轮对话抽成原子事实写进知识库，下轮自动检索回来。0/false/off/no 关闭。
AGENT_AUTO_MEMORY=1
# 用户画像刷新间隔（轮）。攒够这么多轮就把最近的记忆汇总成一段「这个人是谁」的画像。
# 调低它主要给端到端测试用（例如 3），平时保持缺省的 20 就行。
AGENT_PROFILE_EVERY_TURNS=20
# 上下文压缩：对话变长后把早期消息压成滚动摘要，只把摘要 + 最近若干条发给模型。
# AGENT_COMPACT=0 可关闭；TRIGGER 是历史超过多少条才启动，KEEP 是最近保留多少条不参与压缩。
AGENT_COMPACT=1
AGENT_COMPACT_TRIGGER=24
AGENT_COMPACT_KEEP=10
# 模型上下文窗口（估算值）。设置后：单条工具结果上限 = 窗口 10%，中段压缩在窗口 60% 触发。
# 不设时沿用旧默认（单条 16000 字符 / 估算 24000 token 触发压缩）。
# AGENT_CONTEXT_TOKENS=128000
# 显式覆盖中段压缩阈值（估算 token）与单条工具结果字符上限；显式值优先于窗口比例。
# AGENT_MIDLOOP_COMPACT_TOKENS=24000
# AGENT_TOOL_OUTPUT_CAP=16000
# 子 agent 委派（docs/agent/06-subagent.md）：模型可以把自足的子任务派给后台子 agent，跑完自动回投结果。
# MAX_DEPTH 是嵌套深度上限：1 = 只允许主 agent 派一层（子 agent 不能再派活）；0 = 完全关掉委派。
# MAX_CHILDREN 是同一棵委派树同时运行的子 agent 上限，满了直接拒绝而不是排队。
AGENT_MAX_DEPTH=2
AGENT_MAX_CHILDREN=4

# ---- Hermes 对标：工具编排 / 自我进化（docs/agent/11-hermes-parity.md）----
# 全部默认关闭：不配这些变量时 /api/chat 的工具清单、提示词与 SSE 序列与改造前一致。
# 只暴露指定工具集（逗号分隔）；不配 = 全量。
# AGENT_TOOLSETS=fs,memory,skill,exec,agent,team,evolve,mcp
# search = 核心工具 + tool_search 渐进披露；off = 全量（默认）。
# AGENT_TOOL_DISCLOSURE=search
# read = 只读工具并发执行（默认串行），legacy 与 eino 两个执行器都生效；写工具始终独占。
# AGENT_TOOL_PARALLEL=read
# AGENT_TOOL_PARALLEL_MAX=4
# 工具结果超过该字节数就落盘，模型只看到头部 + 路径。
# AGENT_TOOL_SPILL_BYTES=32768
# 文件检查点目录：write/edit/move/delete 前自动留副本；restore 恢复单个文件，restore_turn 整组回滚最近一轮。
# 默认在用户缓存目录下的 blog-my/checkpoints；单文件上限 5MB，每个目标保留最近 10 份。
# AGENT_CHECKPOINT_DIR=E:\blog-my\workspace\checkpoints
# 自我进化：off / record / suggest / auto（默认 off）。auto 仅主账号且本轮允许自主创作技能时改库。
# AGENT_EVOLVE=suggest
# 进化数据目录（轨迹 JSONL、技能账本、候选、评测）。
# AGENT_EVOLVE_DIR=E:\blog-my\workspace\evolve
# 用户记忆/轨迹/报告分用户哈希子目录保存，工具长结果再按会话隔离。
# 技能体检：off / warn（默认）/ block。
# AGENT_SKILL_LINT=warn
# MCP：外部服务器配置（二选一）。不配 = 不启动任何进程、不暴露 mcp__ 工具。
# AGENT_MCP_CONFIG=E:\blog-my\mcp.json
# AGENT_MCP_JSON={"servers":[{"name":"demo","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","E:\\tmp"]}]}

# ---- 自媒体排期自动导出（content_publication 自动任务）----
# 到点把 planned 的排期渲染成 Markdown 成品包落盘，并把台账推进到 exported；
# 不代替你发平台（不会写 published_at）。失败按 1min/2min/4min… 退避，上限 1 小时。
# 检查间隔（分钟）：默认 5；<=0 关闭后台调度（POST /api/content/jobs/run 仍可手动触发）。
# CONTENT_PUBLISH_INTERVAL_MINUTES=5
# 成品包目录；默认用户配置目录下的 blog-my\content-publish
# CONTENT_EXPORT_DIR=E:\blog-my\artifacts\content-publish
# 每轮最多处理条数（默认 20，上限 100）
# CONTENT_PUBLISH_BATCH=20
# 单条排期最多尝试次数（默认 3）；用尽后台账落到 failed，留原因等人工处理
# CONTENT_PUBLISH_MAX_ATTEMPTS=3

# ---- 定时唤醒（到点让 agent 在会话里自己跑一轮）----
# 用户说「明早 9 点提醒我」或 agent 自己安排「晚点再检查」都会落到 agent_wakeup 表。
# 检查间隔（秒）：默认 30；<=0 只关后台调度，建单/取消接口仍然可用。
# AGENT_WAKEUP_INTERVAL_SECONDS=30
# 每轮最多处理几条（默认 10，上限 50）
# AGENT_WAKEUP_BATCH=10
# 单条唤醒最多尝试次数（默认 3）；用尽后状态落 failed，原因写进台账
# AGENT_WAKEUP_MAX_ATTEMPTS=3
